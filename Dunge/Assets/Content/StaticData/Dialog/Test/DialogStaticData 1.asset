          text: "\u041E\u0442\u0432\u0435\u0442 2"
          nextDialogId: 2
      - id: 2
        speaker: 0
        text: "\u042F\u0441\u043D\u043E. \u0425\u043E\u0447\u0443 \u0437\u0430\u0434\u0430\u0442\u044C
          \u0442\u0435\u0431\u0435 \u0432\u043E\u043F\u0440\u043E\u0441."
        responces:
        - id: 1
          speaker: 0
          text: "\u0422\u044B \u0418\u0433\u043E\u0440\u044C \u041F\u043E\u0442\u043E\u0432?"
          nextDialogId: 3
        - id: 2
          speaker: 0
          text: "\u0427\u0435 \u043A\u0430\u043A \u043F\u043E\u0436\u0438\u0432\u0430\u0435\u0448\u044C?"
          nextDialogId: 4
      - id: 3
        speaker: 1
        text: "\u041E\u0433\u043E \u043A\u0430\u043A \u0442\u044B \u0443\u0433\u0430\u0434\u0430\u043B"
        responces:
        - id: 1
          speaker: 1
          text: "\u0410 \u0445\u043E\u0442\u044F \u043B\u0430\u0434\u043D\u043E \u044D\u0442\u043E
            \u0431\u044B\u043B\u043E \u043D\u0435\u0441\u043B\u043E\u0436\u043D\u043E"
          nextDialogId: 5
      - id: 4
        speaker: 1
        text: "\u0414\u0430 \u0442\u0430\u043A \u043F\u0440\u043E\u043C\u044B\u0448\u043B\u044F\u044E
          \u0442\u043E \u0442\u0430\u043C \u0442\u043E \u0442\u0443\u0442."
        responces:
        - id: 1
          speaker: 0
          text: "\u042F\u0441\u043D\u043E. \u041F\u043E\u043A\u0430."
