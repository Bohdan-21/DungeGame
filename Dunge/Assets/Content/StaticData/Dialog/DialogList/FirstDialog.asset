--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e1cc3c2a312388d408918a27d98c3214, type: 3}
  m_Name: FirstDialog
  m_EditorClassIdentifier: 
  ShowOneTime: 1
  dialog:
  - language: 0
    dialogList:
      dialogs:
      - id: 1
        speaker: 0
        text: "\u0417\u0434\u0440\u0430\u0441\u0442\u0432\u0443\u0439 \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u0430."
        responces:
        - id: 1
          speaker: 1
          text: "\u0417\u0434\u0440\u0430\u0441\u0442\u0432\u0443\u0439 \u0438\u0433\u0440\u043E\u043A.
            \u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
            \u0432 \u043D\u0430\u0448\u0435 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u0438\u0435.
            \u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044C
            \u0432\u0441\u0435 \u0447\u0442\u043E \u0443\u0433\u043E\u0434\u043D\u043E,
            \u043D\u0443 \u0430 \u044F \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C
            \u043E\u0442\u0432\u0435\u0442\u0438\u0442\u044C \u043D\u0430 \u0442\u0432\u043E\u0438
            \u0432\u043E\u043F\u0440\u043E\u0441\u044B."
          nextDialogId: 2
      - id: 2
        speaker: 0
        text: "\u041E \u0441\u043F\u0430\u0441\u0438\u0431\u043E \u0437\u0430 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E."
        responces:
        - id: 1
          speaker: 1
          text: "\u041F\u043E\u043C\u043E\u0433\u0443 \u0447\u0435\u043C \u0441\u043C\u043E\u0433\u0443."
          nextDialogId: 3
      - id: 3
        speaker: 0
        text: "\u0412\u043E\u043F\u0440\u043E\u0441."
        responces:
        - id: 1
          speaker: 0
          text: "\u041A\u0442\u043E \u0442\u044B \u0442\u0430\u043A\u043E\u0439?"
          nextDialogId: 4
        - id: 2
          speaker: 0
          text: "\u0427\u0442\u043E \u0437\u0430 \u0432\u0435\u0434\u044C\u043C\u0430
            \u043D\u0430 \u043E\u043A\u0440\u0430\u0438\u043D\u0435 \u0434\u0435\u0440\u0435\u0432\u043D\u0438?"
          nextDialogId: 5
        - id: 3
          speaker: 0
          text: "\u0427\u0442\u043E \u0437\u0430 \u0447\u0443\u0434\u0438\u043A \u0432\u043E\u0437\u043B\u0435
            \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0430?"
          nextDialogId: 6
        - id: 4
          speaker: 0
          text: "\u0427\u0442\u043E \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E
            \u0434\u0435\u043B\u0430\u0442\u044C?"
          nextDialogId: 7
      - id: 4
        speaker: 1
        text: "\u042F \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u0430
          \u0434\u0435\u0440\u0435\u0432\u043D\u0438, \u043D\u0443 \u0430 \u0435\u0449\u0435
          \u044F \u0442\u0432\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u043E\u0434\u0430\u0442\u0435\u043B\u044C."
        responces:
        - id: 1
          speaker: 1
          text: "\u0414\u0440\u0443\u0433\u0438\u043C\u0438 \u0441\u043B\u043E\u0432\u0430\u043C\u0438
            \u044F \u0442\u043E\u0442 \u043A\u0442\u043E \u0432\u044B\u043F\u043B\u0430\u0442\u0438\u0442
            \u0442\u0435\u0431\u0435 \u0434\u0435\u043D\u044C\u0433\u0438 \u043F\u043E\u0441\u043B\u0435
            \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u044F \u0442\u0432\u043E\u0435\u0439
            \u0440\u0430\u0431\u043E\u0442\u044B."
          nextDialogId: 8
      - id: 5
        speaker: 1
        text: "\u0410 \u0442\u044B \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435
          \u043F\u0440\u043E \u041A\u043B\u0435\u0440."
        responces:
        - id: 1
          speaker: 1
          text: "\u041A\u043B\u0435\u0440 \u044D\u0442\u0430 \u043D\u0430\u0448\u0430
            \u043C\u0435\u0441\u0442\u043D\u0430\u044F \u043A\u043E\u043B\u0434\u0443\u043D\u044C\u044F.
            \u041E\u043D\u0430 \u0442\u043E\u0440\u0433\u0443\u0435\u0442 \u0437\u0435\u043B\u044C\u044F\u043C\u0438
            \u043D\u0443, \u0430 \u0442\u0430\u043A\u0436\u0435 \u044F \u0441\u0443\u043C\u0435\u043B
            \u0435\u0435 \u0443\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0447\u0442\u043E\u0431\u044B
            \u043E\u043D\u0430 \u043F\u043E\u0432\u044B\u0448\u0430\u043B\u0430 \u0442\u0432\u043E\u0439
            \u0443\u0440\u043E\u0432\u0435\u043D\u044C."
          nextDialogId: 8
      - id: 6
        speaker: 1
        text: "\u042D\u0442\u043E\u0442 \u044D\u044D\u044D..."
        responces:
        - id: 1
          speaker: 1
          text: "\u0427\u0443\u0434\u0438\u043A \u043A\u0430\u043A \u0442\u044B \u0432\u044B\u0440\u0430\u0437\u0438\u043B\u0441\u044F
            \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u0441\u0442\u043E\u0440\u043E\u0436
            \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0430, \u043D\u0430 \u0441\u0430\u043C\u043E\u043C
            \u0434\u0435\u043B\u0435 \u043E\u043D \u0445\u043E\u0440\u043E\u0448\u044B\u0439
            \u043F\u0430\u0440\u0435\u043D\u044C, \u043D\u043E \u0435\u043C\u0443
            \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u043E\u0434\u0435\u0442\u044C
            \u0442\u044B\u043A\u0432\u0443 \u043F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E
            \u043A\u0430\u043A \u0438\u0437 \u0443\u0441\u044B\u043F\u0430\u043B\u043D\u0438
            \u043D\u0430\u0447\u0430\u043B\u0438 \u0432\u044B\u0440\u044B\u0432\u0430\u0442\u044C\u0441\u044F
            \u0441\u043A\u0435\u043B\u0435\u0442\u044B. \u041E\u043D \u0432\u0435\u0440\u0438\u0442
            \u0447\u0442\u043E \u0442\u044B\u043A\u0432\u0430 \u043E\u0442\u043F\u0443\u0433\u0438\u0432\u0430\u0435\u0442
            \u0438\u0445. \u0425\u043E\u0442\u044F \u044F \u0432\u0438\u0434\u0435\u043B
            \u043A\u0430\u043A \u043E\u043D\u0438 \u0441\u043C\u0435\u044F\u043B\u0438\u0441\u044C
            \u043D\u0430\u0434 \u043D\u0438\u043C."
          nextDialogId: 8
      - id: 7
        speaker: 1
        text: "\u0422\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u044C
          \u0432\u0435\u0434\u044C\u043C\u0443 \u043A\u043E\u0442\u043E\u0440\u0430\u044F
          \u0437\u0430\u0441\u0435\u043B\u0430 \u0432 \u0443\u0441\u044B\u043F\u0430\u043B\u044C\u043D\u0438."
        responces:
        - id: 1
          speaker: 1
          text: "\u041D\u043E \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C
            \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u043A \u043D\u0435\u0439
            \u0442\u0435\u0431\u0435 \u043F\u0440\u0438\u0439\u0434\u0435\u0442\u0441\u044F
            \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u044C \u043C\u0435\u0441\u0442\u043D\u044B\u0445
            \u0441\u043A\u0435\u043B\u0435\u0442\u043E\u0432."
          nextDialogId: 8
      - id: 8
        speaker: 1
        text: "\u041D\u0430\u0434\u0435\u044E\u0441\u044C \u0442\u0435\u0431\u044F
          \u0443\u0434\u043E\u0432\u043B\u0435\u0442\u0432\u043E\u0440\u0438\u043B
          \u043C\u043E\u0439 \u043E\u0442\u0432\u0435\u0442."
        responces:
        - id: 1
          speaker: 0
          text: "\u0412\u0435\u0440\u043D\u0435\u043C\u0441\u044F \u043A \u0434\u0440\u0443\u0433\u0438\u043C
            \u0432\u043E\u043F\u0440\u043E\u0441\u0430\u043C."
          nextDialogId: 3
        - id: 2
          speaker: 0
          text: "\u0412\u0441\u0435 \u044F\u0441\u043D\u043E \u043F\u043E\u043A\u0430."
          nextDialogId: -1
