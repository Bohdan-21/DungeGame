  dialog:
  - language: 0
    dialogList:
      dialogs:
      - id: 1
        speaker: 1
        text: "\u041F\u0440\u0438\u0432\u0435\u0442, \u043A\u0430\u043A \u0434\u0435\u043B\u0430?"
        responces:
        - id: 1
          speaker: 0
          text: "\u041F\u0440\u0438\u0432\u0435\u0442, \u0443 \u043C\u0435\u043D\u044F
            \u0432\u0441\u0451 \u0445\u043E\u0440\u043E\u0448\u043E! \u0410 \u0443
            \u0442\u0435\u0431\u044F \u043A\u0430\u043A?"
          nextDialogId: 2
        - id: 2
          speaker: 0
          text: "\u041D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E, \u0430 \u0443
            \u0442\u0435\u0431\u044F?"
          nextDialogId: 3
      - id: 2
        speaker: 1
        text: "\u0423 \u043C\u0435\u043D\u044F \u0432\u0441\u0451 \u0445\u043E\u0440\u043E\u0448\u043E,
          \u0441\u043F\u0430\u0441\u0438\u0431\u043E."
        responces:
        - id: 1
          speaker: 0
          text: "\u042D\u0442\u043E \u0437\u0434\u043E\u0440\u043E\u0432\u043E, \u0440\u0430\u0434
            \u0437\u0430 \u0442\u0435\u0431\u044F."
          nextDialogId: -1
      - id: 3
        speaker: 1
        text: "\u0422\u043E\u0436\u0435 \u0432\u0441\u0451 \u0445\u043E\u0440\u043E\u0448\u043E,
          \u0441\u043F\u0430\u0441\u0438\u0431\u043E"
        responces:
        - id: 1
          speaker: 0
          text: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E"
          nextDialogId: -1
  - language: 1
    dialogList:
      dialogs:
      - id: 1
        speaker: 1
        text: Hello how are you?
        responces:
        - id: 1
          speaker: 0
          text: Hi I`m fine! And you?
          nextDialogId: 2
        - id: 2
          speaker: 0
          text: Fine, and you?
          nextDialogId: 3
      - id: 2
        speaker: 1
        text: I`m fine thanks.
        responces:
        - id: 1
          speaker: 0
          text: Thats grate, happy for you.
          nextDialogId: -1
      - id: 3
        speaker: 1
        text: Me too thank you.
        responces:
        - id: 1
          speaker: 0
          text: Its good.
          nextDialogId: -1
